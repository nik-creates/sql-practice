# Persistent app DB (stores query history) and default PostgreSQL practice DB
DATABASE_URL=postgres://user:pass@localhost:5432/sqlpractice
# Optional: separate PostgreSQL for practice queries (defaults to DATABASE_URL, schema "practice")
PRACTICE_PG_URL=
# Optional: MySQL practice DB. MySQL option is disabled when unset
MYSQL_URL=mysql://user:pass@localhost:3306/practice
# Set to "false" for local DBs without SSL
PG_SSL=false
MYSQL_SSL=false

# Auth (single user). Generate hash: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD',10))"
APP_USER=
APP_PASS_HASH=
JWT_SECRET=change-me

# Cloudflare Turnstile on login. Secret is server-side; site key is public and read at client build time.
# With NODE_ENV=production a missing TURNSTILE_SECRET blocks all logins. Locally (NODE_ENV not production) the check is skipped.
# Cloudflare test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA (always pass)
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=
NODE_ENV=development
PORT=3000
